{
  "configurations": [
    {
      "id": "C9671065-7F0B-439F-ABD6-FA642CFD992E",
      "name": "Release, no sanitizer",
      "options": {}
    },
    {
      "id": "3F1C6B84-2C2E-4A63-9E6B-6D2C0A9C51D2",
      "name": "Release, all rungs",
      "options": {
        "environmentVariableEntries": [
          {
            "key": "MACDIRSTAT_PERFORMANCE_RUNGS",
            "value": "all"
          },
          {
            "key": "MACDIRSTAT_PERFORMANCE_RECORD_DIR",
            "value": "$(SRCROOT)/.plan/maps/macos-disk-visualizer-impl/records"
          },
          {
            "key": "MACDIRSTAT_PERFORMANCE_FIXTURE_DIR",
            "value": "$(SRCROOT)/.performance-fixture"
          }
        ]
      }
    }
  ],
  "defaultOptions": {
    "addressSanitizer": {
      "enabled": false
    },
    "mainThreadCheckerEnabled": false,
    "mallocScribbleEnabled": false,
    "nsZombieEnabled": false,
    "targetForVariableExpansion": {
      "containerPath": "container:MacDirStat.xcodeproj",
      "identifier": "AB000000000000000000A001",
      "name": "MacDirStat"
    },
    "threadSanitizerEnabled": false,
    "undefinedBehaviorSanitizerEnabled": false
  },
  "testTargets": [
    {
      "target": {
        "containerPath": "container:MacDirStat.xcodeproj",
        "identifier": "AB000000000000000000A004",
        "name": "MacDirStatPerformanceTests"
      }
    }
  ],
  "version": 1
}
